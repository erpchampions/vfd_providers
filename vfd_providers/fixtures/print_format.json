  "html": "{% if doc.company == \"MOGAS Tanzania\" %}\n    <div class=\"letterhead\">\n        {% set letterhead_name = frappe.db.get_value(\"Letter Head\", {\"custom_company\": doc.company}, \"name\") %}\n        {% if letterhead_name %}\n            {% set letterhead = frappe.get_doc(\"Letter Head\", letterhead_name) %}\n            {{ letterhead.content | safe }}\n        {% endif %}\n    </div>\n\n    <table width=\"100%;\">\n        <tr>\n            <td style=\"width: 33%; \">\n                \n            </td>\n            <td style=\"width: 34%; font-size: 18px; font-weight: bold; color: black; text-align: center;\">\n                {{ \"TAX INVOICE\" }}\n            </td>\n            <td style=\"width: 33%; font-size: 14px; color: black; text-align: right;\">\n                {{ \"TIN \" }} {{ doc.company_tax_id }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 33%; \">\n                \n            </td>\n            <td style=\"width: 34%; font-size: 14px; color: black; text-align: center;\">\n                {{ \"Invoice No:\" }}<br>{{ doc.name }}\n            </td>\n            <td style=\"width: 33%; font-size: 14px; color: black; text-align: right;\">\n                 {{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-YYYY\") }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 33%; \">\n                \n            </td>\n            <td style=\"width: 34%; font-size: 14px; color: black; text-align: center;\">\n                {{ \"\" }}\n            </td>\n            <td style=\"width: 33%; font-size: 14px; color: black; text-align: right;\">\n                 {{ \"30-DAYS\" }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 33%; \">\n                {{ \"\" }}\n            </td>\n            <td style=\"width: 34%; font-size: 14px; color: black; text-align: center;\">\n                {{ \"\" }}\n            </td>\n            <td style=\"width: 33%; font-size: 14px; color: black; text-align: right;\">\n                 {% if doc.custom_order %}\n                    {{ doc.custom_order }}\n                 {% endif %}\n            </td>\n        </tr>\n    </table>\n    <table style=\"width: 100%;\">\n        <tr>\n            <td style=\"width: 50%; font-size: 13px; color:black;\">\n                <b>{{ \"Sold To: \" }}</b><br> \n                    {{ doc.customer_name }}<br>\n                {% if doc.address_display %}\n                    {{ doc.address_display }}<br>\n                    {%set tin = doc.tax_id%}\n                    {%if tin%}\n                    <b>{{ \"CUS TIN \" }}</b>{{tin}} {%else%}{{\"\"}}{%endif%}<b>{%set vrn = doc.custom_vrn%} {%if vrn%}{{ \" \"~\"VRN: \"}}</b>{{ vrn }}{%else%}{{\"\"}}{%endif%}\n                {% else %}\n                    <span style=\"color: #7f7f7f; font-style: italic;\">\n                        {{ \" Address Not Available\" }}\n                    </span><br>\n                    <b>{{ \"CUS TIN \" }}</b>{{ doc.tax_id }}<b>{{ \"  \"~\"VRN: \"}}</b>{{ doc.custom_vrn }}\n                {% endif %}\n            </td>\n            <td style=\"width: 50%; font-size: 14px; color: black; text-align: center;\">\n                {{ \"\" }}\n            </td>\n        </tr> \n    </table>\n    <table width=\"100%\" style=\"margin-top: 50px;\">\n            <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; font-weight: bold;\">\n                    {{ \"Delivery Note\" }}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n            </tr>\n        {% for line in doc.items %}\n            <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {{ line.item_name }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; \">\n                    {% if line.delivery_note %}\n                        {{ line.delivery_note }}\n                    {% else %}\n                        <span style=\"color: #7f7f7f; font-style: italic;\">\n                            {{ \"Not available\" }}\n                        </span>\n                    {% endif %}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; text-align: right;\">\n                    {{ line.qty ~ line.uom }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ frappe.format_value(line.rate, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ frappe.format_value(line.amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n            </tr>\n        {% endfor %}\n            <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {{ \"VAT 18\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; text-align: right;\">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ \"18.0\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {% set vat_amt = \"%.2f\"|format(doc.total_taxes_and_charges) %} {# 0.18 * doc.total|flt #}\n                    {{ frappe.format_value(vat_amt, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n            </tr>\n             <tr style=\"width: 100%;\">\n                <td style=\"width: 20%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 40%; font-size: 13px; color: black; \">\n                    {% set grand_amount = vat_amt|flt + doc.total|flt %}\n                    {% set grand_amt = frappe.utils.money_in_words(grand_amount) %}\n                    {% set amt_in_words = grand_amt.replace(\"UGX\",\"\") %}\n                    {% set in_words = amt_in_words.replace(\"only.\", \"\") %}\n                    {% if doc.currency == \"USD\" %}\n                        {{ doc.in_words }}\n                    {% else %}\n                        {{ doc.base_in_words }}\n                    {% endif %}\n                    {# {{ in_words ~ \" Tanzania Shillings Only\" }}#}\n                </td>\n                   <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ \"\"}}\n                </td>\n                 <td style=\"width: 10%; font-size: 13px; color: black; text-align: right;\">\n                    {{ \"\"}}\n                </td>\n                 <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    \n                    {{ frappe.format_value(doc.grand_total, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n                \n            </tr>\n            <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 12px; color: black; \">\n                \n                       <b> {{ \"Remarks :\" }} </b> {{ doc.remarks }}\n            \n                </td>\n                <td style=\"width: 50%; font-size: 13px; color: black; \">\n                    \n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    \n                </td>\n            </tr>\n             <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    <div style=\"margin-left: 20px;\">\n                        <span style=\"border-bottom: 1px dashed black;\">\n                            {{ \"For Customer Use:\" }}\n                        </span>\n                    </div>\n                </td>\n                <td style=\"width: 50%; font-size: 13px; color: black; \">\n                    \n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    \n                </td>\n            </tr>\n            <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    <div style=\"margin-left: 57px;\">\n                        <span>\n                            {{ \"Received By:\" }}\n                        </span>\n                    </div>\n                </td>\n                <td style=\"width: 50%; font-size: 13px; color: black; \">\n                    \n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    \n                </td>\n            </tr>\n             <tr style=\"width: 100%;\">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    <div style=\"margin-left: 100px;\">\n                        <span>\n                            {{ \"Date:\" }}\n                        </span>\n                    </div>\n                </td>\n                <td style=\"width: 50%; font-size: 13px; color: black; \">\n                    \n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    \n                </td>\n            </tr>\n            <tr style=\"width: 100%; font-size: 13px; color: black; \">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {% if doc.currency == \"USD\" %}\n                        {{ \"Total Invoice Amount(USD):\" }}\n                    {% else %}\n                        {{ \"Total Invoice Amount(TZS):\" }}\n                    {% endif %}\n                </td>\n                 <td style=\"width: 10%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ frappe.format_value(doc.grand_total, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n            </tr>\n             <tr style=\"width: 100%; font-size: 13px; color: black; \">\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 30%; font-size: 13px; color: black; \">\n                    {% if doc.currency == \"USD\" %}\n                        {{ \"Total Tax Amount(USD):\" }}\n                    {% else %}\n                        {{ \"Total Tax Amount(TZS):\" }}\n                    {% endif %}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 10%; font-size: 13px; color: black; \">\n                    {{ \"\" }}\n                </td>\n                <td style=\"width: 20%; font-size: 13px; color: black; text-align: right;\">\n                    {{ frappe.format_value(vat_amt, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n            </tr>\n    </table>\n        {% if doc.vfd_rctvnum or doc.vfd_verification_url %}\n            <table style=\"width: 100%;\">\n                <tbody>\n                    <tr style=\"width: 100%; text-align: center;\">\n                        <td style=\"width: 40%; text-align: left; vertical-align: middle; font-size: 12px; color: 9f9f9f;\">\n                        \n                            {{ \"RECEIPT VERIFICATION CODE\" }} <br>\n                            {{ doc.vfd_rctvnum }}\n                        </td>\n                        <!-- <td style=\"width: 10%; text-align: center; vertical-align: middle; font-size: 12px; color: 9f9f9f;\">-->\n                          \n                        <!--</td>-->\n                        <td style=\"width: 60%; text-align: center; vertical-align: middle; font-size: 12px; color: 9f9f9f;\">\n                            \n                            {{ \"VFD URL\" }} <br>\n                            {{ doc.vfd_verification_url }}\n                        </td>\n                    </tr>\n                    <tr style=\"width: 100%;\">\n                        <td style=\"width: 60%; \">\n                            {{ \"\" }}\n                        </td>\n                        <td style=\"width: 40%; text-align: right; vertical-align: middle; font-size: 12px; color: 9f9f9f;\">\n                            \n                            {{ \"VFD QR CODE\" }} <br>\n                            <img src=\"https://barcode.tec-it.com/barcode.ashx?data={{ doc.vfd_verification_url }}&code=QRCode\" \n                            style=\"width: 120px; height: 120px;\"/>\n                        </td>\n                    </tr>\n                   \n                </tbody>\n            </table>\n            </table>\n        {% endif %}\n{% else %}\n    <div class=\"letterhead\">\n        {% if doc.company %}\n            {% set letterhead_name = frappe.db.get_value(\"Letter Head\", {\"custom_company\": doc.company}, \"name\") %}\n            {% if letterhead_name %}\n                {% set letterhead = frappe.get_doc(\"Letter Head\", letterhead_name) %}\n                {{ letterhead.content | safe }}\n            {% endif %}\n        {% endif %}\n    </div>\n    \n    \n        <table style=\"width: 100%;\">\n            <tbody>\n                <tr>\n                    <td style=\"width: 100%; font-size: 20px; font-family: Noto Serif; color: black; text-align: center; vetical-align: middle;\">\n                        <b>TAX INVOICE</b>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        <table style=\"width: 100%; border-spacing: 0\">\n            <tbody>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"Invoice No\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ doc.name }}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"Date\" }}</b>\n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 15px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ frappe.utils.formatdate(doc.posting_date) }}\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"Customer No\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ doc.custom_customer_number }}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"Currency\" }}</b>\n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ doc.party_account_currency }}\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"Customer Name\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color:black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ doc.customer_name }}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color:black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color:black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"Payment Terms\" }}</b>\n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {% if doc.payment_terms_template %}\n                            {{ doc.payment_terms_template }}\n                        {% else %}\n                            {% for schedule in doc.payment_schedule %}\n                                {{ schedule.invoice_portion }}{{ \"%\" }}\n                            {% endfor%}\n                        {% endif %}\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"Order Number\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       {% for item in doc.items %}\n                            {{item.sales_order}}\n                        {% endfor %}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"\" }}</b>\n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \"\" }}\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"VRN\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \"\" }}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"\" }}</b>\n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{\"\"}}\n                    </td>\n                </tr>\n                <tr>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                       <b>{{ \"TIN\" }}</b> \n                    </td>\n                    <td style=\"width: 2%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \":\" }}</b>\n                    </td>\n                    <td style=\"width: 27%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ doc.company_tax_id }}\n                    </td>\n                    <td style=\"width: 6%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        {{ \" \" }}\n                    </td>\n                    <td style=\"width: 18%; font-size: 13px; color: black; padding-top: 0 !important; padding-bottom: 8px !important;\">\n                        <b>{{ \"\"